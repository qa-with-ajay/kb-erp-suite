model PanelOperation {
  id              String             @id @default(uuid()) @db.Uuid
  businessUnitId  String             @db.Uuid
  movementId      String             @unique @db.Uuid
  productId       String             @db.Uuid
  variantId       String?            @db.Uuid
  sourceRemnantId String?            @unique @db.Uuid
  type            PanelOperationType
  inputLength     Decimal            @db.Decimal(12, 4)
  inputWidth      Decimal            @db.Decimal(12, 4)
  soldArea        Decimal            @default(0) @db.Decimal(14, 4)
  wastedArea      Decimal            @default(0) @db.Decimal(14, 4)
  createdAt       DateTime           @default(now())

  businessUnit   BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  movement       StockMovement     @relation(fields: [businessUnitId, movementId], references: [businessUnitId, id], onDelete: Restrict)
  product        Product           @relation(fields: [businessUnitId, productId], references: [businessUnitId, id], onDelete: Restrict)
  variant        ProductVariant?   @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id], onDelete: Restrict)
  sourceRemnant  Remnant?          @relation("RemnantSource", fields: [businessUnitId, sourceRemnantId], references: [businessUnitId, id], onDelete: Restrict)
  outputRemnants Remnant[]         @relation("RemnantOutput")
  remnantHistory RemnantMovement[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, movementId])
  @@unique([businessUnitId, sourceRemnantId])
  @@index([businessUnitId, productId, createdAt])
}

model Remnant {
  id                String        @id @default(uuid()) @db.Uuid
  businessUnitId    String        @db.Uuid
  code              String
  productId         String        @db.Uuid
  variantId         String?       @db.Uuid
  locationId        String        @db.Uuid
  sourceOperationId String        @db.Uuid
  length            Decimal       @db.Decimal(12, 4)
  width             Decimal       @db.Decimal(12, 4)
  area              Decimal       @db.Decimal(14, 4)
  status            RemnantStatus @default(AVAILABLE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  businessUnit    BusinessUnit      @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [businessUnitId, productId], references: [businessUnitId, id], onDelete: Restrict)
  variant         ProductVariant?   @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id], onDelete: Restrict)
  location        StockLocation     @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id], onDelete: Restrict)
  sourceOperation PanelOperation    @relation("RemnantOutput", fields: [businessUnitId, sourceOperationId], references: [businessUnitId, id], onDelete: Restrict)
  usedAsSource    PanelOperation?   @relation("RemnantSource")
  movements       RemnantMovement[]

  @@unique([businessUnitId, code])
  @@unique([businessUnitId, id])
  @@index([businessUnitId, productId, variantId, status])
  @@index([businessUnitId, locationId, status])
}

model RemnantMovement {
  id             String              @id @default(uuid()) @db.Uuid
  businessUnitId String              @db.Uuid
  remnantId      String              @db.Uuid
  operationId    String?             @db.Uuid
  locationId     String              @db.Uuid
  actorId        String
  type           RemnantMovementType
  quantityDelta  Decimal             @db.Decimal(14, 4)
  reason         String?
  createdAt      DateTime            @default(now())

  businessUnit BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  remnant      Remnant         @relation(fields: [businessUnitId, remnantId], references: [businessUnitId, id], onDelete: Restrict)
  operation    PanelOperation? @relation(fields: [businessUnitId, operationId], references: [businessUnitId, id], onDelete: Restrict)
  location     StockLocation   @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id], onDelete: Restrict)
  actor        User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([businessUnitId, remnantId, createdAt])
}
