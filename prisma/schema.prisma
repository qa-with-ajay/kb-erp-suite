generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(cuid())
  name                    String
  email                   String                 @unique
  passwordHash            String
  passwordVersion         Int                    @default(0)
  passwordResetTokens     PasswordResetToken[]
  role                    UserRole               @default(CASHIER)
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  auditLogs               AuditLog[]
  lowStockNotifications   LowStockNotification[]
  paymentsRecorded        Payment[]              @relation("PaymentRecorder")
  paymentsReversed        Payment[]              @relation("PaymentReverser")
  purchaseOrders          PurchaseOrder[]        @relation("PurchaseOrderCreator")
  purchaseReceipts        PurchaseReceipt[]      @relation("PurchaseReceiptCreator")
  purchaseReturns         PurchaseReturn[]       @relation("PurchaseReturnCreator")
  purchaseReturnReversals PurchaseReturn[]       @relation("PurchaseReturnReverser")
  materialRemnantMovements        MaterialRemnantMovement[]
  sales                   Sale[]                 @relation("SaleCreator")
  salesReturns            SaleReturn[]           @relation("SaleReturnCreator")
  salesReturnReversals    SaleReturn[]           @relation("SaleReturnReverser")
  stockMovements          StockMovement[]
  businessUnitRoles       UserBusinessUnitRole[]
  groupRoles              UserGroupRole[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BusinessProfile {
  id             String             @id @default(cuid())
  legalName      String?
  tradeName      String             @default("KB Interiors")
  unit           LegacyBusinessUnit @default(KB_INTERIORS)
  gstin          String?
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  stateCode      String?
  pincode        String?
  invoicePrefix  String             @default("KBI")
  nextInvoiceNo  Int                @default(1)
  currency       String             @default("INR")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  businessUnitId String             @unique @db.Uuid
  businessUnit   BusinessUnit       @relation(fields: [businessUnitId], references: [id])
}

model OrganizationProfile {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @default("Kumar Brothers & Associates")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  action         String
  entity         String
  entityId       String?
  details        Json?
  createdAt      DateTime      @default(now())
  businessUnitId String?       @db.Uuid
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([businessUnitId, createdAt])
  @@index([createdAt])
}

model BusinessUnit {
  id                      String                  @id @default(uuid()) @db.Uuid
  code                    String                  @unique
  name                    String
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  nextPurchaseOrderNo     Int                     @default(1)
  nextPurchaseDebitNoteNo Int                     @default(1)
  nextSalesCreditNoteNo   Int                     @default(1)
  auditLogs               AuditLog[]
  brands                  Brand[]
  profile                 BusinessProfile?
  categories              Category[]
  customers               Customer[]
  lowStockNotifications   LowStockNotification[]
  materialProcessings         MaterialProcessing[]
  payments                Payment[]
  products                Product[]
  unitConversions         ProductUnitConversion[]
  variants                ProductVariant[]
  purchaseOrders          PurchaseOrder[]
  purchaseReceipts        PurchaseReceipt[]
  purchaseReturns         PurchaseReturn[]
  materialRemnants                MaterialRemnant[]
  materialRemnantMovements        MaterialRemnantMovement[]
  sales                   Sale[]
  salesReturns            SaleReturn[]
  saleStockAllocations    SaleLineStockAllocation[]
  stockBalances           StockBalance[]
  stockLedger             StockLedgerEntry[]
  stockLocations          StockLocation[]
  stockMovements          StockMovement[]
  suppliers               Supplier[]
  userAssignments         UserBusinessUnitRole[]

  @@index([isActive, name])
}

model Role {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String                 @unique
  name        String
  scope       RoleScope
  isSystem    Boolean                @default(true)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  permissions RolePermission[]
  unitUsers   UserBusinessUnitRole[]
  groupUsers  UserGroupRole[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserGroupRole {
  userId String
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserBusinessUnitRole {
  userId         String
  businessUnitId String       @db.Uuid
  roleId         String       @db.Uuid
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, businessUnitId, roleId])
  @@index([businessUnitId, roleId])
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessUnitId String       @db.Uuid
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  products       Product[]

  @@unique([businessUnitId, name])
  @@unique([businessUnitId, id])
  @@index([businessUnitId, isActive, name])
}

model Brand {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessUnitId String       @db.Uuid
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  products       Product[]

  @@unique([businessUnitId, name])
  @@unique([businessUnitId, id])
  @@index([businessUnitId, isActive, name])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  businessUnitId String       @db.Uuid
  name           String
  phone          String?
  email          String?
  gstin          String?
  addressLine1   String?
  city           String?
  state          String?
  pincode        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  sales          Sale[]

  @@unique([businessUnitId, id])
  @@index([businessUnitId, isActive, name])
  @@index([businessUnitId, phone])
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  businessUnitId   String            @db.Uuid
  name             String
  phone            String?
  email            String?
  gstin            String?
  addressLine1     String?
  city             String?
  state            String?
  pincode          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  businessUnit     BusinessUnit      @relation(fields: [businessUnitId], references: [id])

  @@unique([businessUnitId, id])
  @@index([businessUnitId, isActive, name])
  @@index([businessUnitId, phone])
}

model Product {
  id                    String                  @id @default(uuid()) @db.Uuid
  name                  String
  sku                   String
  description           String?
  productType           ProductType             @default(STANDARD)
  isProcessingEnabled   Boolean                 @default(false)
  baseUnit              MeasurementUnit
  materialUnit          MeasurementUnit?
  materialUnitsPerBaseUnit Decimal?              @db.Decimal(18, 8)
  purchasePrice         Decimal                 @db.Decimal(14, 2)
  sellingPrice          Decimal                 @db.Decimal(14, 2)
  gstPercentage         Decimal                 @default(0) @db.Decimal(5, 2)
  minimumStock          Decimal                 @default(0) @db.Decimal(14, 4)
  barcode               String?
  barcodeType           BarcodeType             @default(INTERNAL)
  imageUrl              String?
  isActive              Boolean                 @default(true)
  categoryId            String?                 @db.Uuid
  brandId               String?                 @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  businessUnitId        String                  @db.Uuid
  lowStockNotifications LowStockNotification[]
  materialProcessings       MaterialProcessing[]
  brand                 Brand?                  @relation(fields: [businessUnitId, brandId], references: [businessUnitId, id])
  category              Category?               @relation(fields: [businessUnitId, categoryId], references: [businessUnitId, id])
  businessUnit          BusinessUnit            @relation(fields: [businessUnitId], references: [id])
  unitConversions       ProductUnitConversion[]
  variants              ProductVariant[]
  purchaseOrderLines    PurchaseOrderLine[]
  purchaseReceiptLines  PurchaseReceiptLine[]
  purchaseReturnLines   PurchaseReturnLine[]
  materialRemnants              MaterialRemnant[]
  saleLines             SaleLine[]
  saleReturnLines       SaleReturnLine[]
  stockBalances         StockBalance[]
  stockLedger           StockLedgerEntry[]

  @@unique([businessUnitId, sku])
  @@unique([businessUnitId, barcode])
  @@unique([businessUnitId, id])
  @@index([businessUnitId, name])
  @@index([businessUnitId, categoryId, isActive])
  @@index([businessUnitId, brandId, isActive])
}

model ProductVariant {
  id                   String                @id @default(uuid()) @db.Uuid
  productId            String                @db.Uuid
  code                 String?
  barcode              String?
  attributes           Json
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  businessUnitId       String                @db.Uuid
  materialProcessings      MaterialProcessing[]
  businessUnit         BusinessUnit          @relation(fields: [businessUnitId], references: [id])
  product              Product               @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  purchaseReturnLines  PurchaseReturnLine[]
  materialRemnants             MaterialRemnant[]
  saleLines            SaleLine[]
  saleReturnLines      SaleReturnLine[]
  stockBalances        StockBalance[]
  stockLedger          StockLedgerEntry[]

  @@unique([businessUnitId, code])
  @@unique([businessUnitId, barcode])
  @@unique([businessUnitId, id])
  @@index([businessUnitId, productId, isActive])
}

model ProductUnitConversion {
  id               String          @id @default(uuid()) @db.Uuid
  productId        String          @db.Uuid
  unit             MeasurementUnit
  conversionFactor Decimal         @db.Decimal(18, 8)
  isPurchaseUnit   Boolean         @default(false)
  isSalesUnit      Boolean         @default(false)
  precision        Int             @default(4)
  roundingMode     RoundingMode    @default(HALF_UP)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  businessUnitId   String          @db.Uuid
  businessUnit     BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  product          Product         @relation(fields: [businessUnitId, productId], references: [businessUnitId, id], onDelete: Cascade)

  @@unique([productId, unit])
  @@index([businessUnitId, productId])
}

model StockLocation {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  code                 String
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  businessUnitId       String             @db.Uuid
  purchaseReceipts     PurchaseReceipt[]
  purchaseReturns      PurchaseReturn[]
  materialRemnants             MaterialRemnant[]
  materialRemnantMovements     MaterialRemnantMovement[]
  salesReturns         SaleReturn[]
  stockBalances        StockBalance[]
  stockLedger          StockLedgerEntry[]
  businessUnit         BusinessUnit       @relation(fields: [businessUnitId], references: [id])
  destinationMovements StockMovement[]    @relation("MovementDestination")
  sourceMovements      StockMovement[]    @relation("MovementSource")

  @@unique([businessUnitId, name])
  @@unique([businessUnitId, code])
  @@unique([businessUnitId, id])
}

model StockMovement {
  id                     String             @id @default(uuid()) @db.Uuid
  type                   StockMovementType
  actorId                String
  sourceLocationId       String?            @db.Uuid
  destinationLocationId  String?            @db.Uuid
  reference              String?
  idempotencyKey         String?
  reason                 String?
  createdAt              DateTime           @default(now())
  businessUnitId         String             @db.Uuid
  materialProcessing         MaterialProcessing?
  purchaseReceipt        PurchaseReceipt?
  purchaseReturnReversal PurchaseReturn?    @relation("PurchaseReturnReversalMovement")
  purchaseReturn         PurchaseReturn?
  sale                   Sale?
  saleReturnReversal     SaleReturn?        @relation("SaleReturnReversalMovement")
  saleReturn             SaleReturn?
  ledgerEntries          StockLedgerEntry[]
  actor                  User               @relation(fields: [actorId], references: [id])
  destinationLocation    StockLocation?     @relation("MovementDestination", fields: [businessUnitId, destinationLocationId], references: [businessUnitId, id])
  businessUnit           BusinessUnit       @relation(fields: [businessUnitId], references: [id])
  sourceLocation         StockLocation?     @relation("MovementSource", fields: [businessUnitId, sourceLocationId], references: [businessUnitId, id])

  @@unique([businessUnitId, idempotencyKey])
  @@unique([businessUnitId, id])
  @@index([businessUnitId, type, createdAt])
  @@index([reference])
}

model StockLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  movementId     String          @db.Uuid
  productId      String          @db.Uuid
  variantId      String?         @db.Uuid
  locationId     String          @db.Uuid
  stockKind      StockKind       @default(STANDARD)
  quantityDelta  Decimal         @db.Decimal(18, 8)
  unitCost       Decimal         @db.Decimal(14, 4)
  createdAt      DateTime        @default(now())
  businessUnitId String          @db.Uuid
  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  location       StockLocation   @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id])
  movement       StockMovement   @relation(fields: [businessUnitId, movementId], references: [businessUnitId, id])
  product        Product         @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  variant        ProductVariant? @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])

  @@index([businessUnitId, productId, variantId, locationId, createdAt])
  @@index([movementId])
}

model StockBalance {
  id             String          @id @default(uuid()) @db.Uuid
  locationId     String          @db.Uuid
  productId      String          @db.Uuid
  variantId      String?         @db.Uuid
  stockKind      StockKind       @default(STANDARD)
  quantity       Decimal         @default(0) @db.Decimal(18, 8)
  averageCost    Decimal         @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime        @updatedAt
  businessUnitId String          @db.Uuid
  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  location       StockLocation   @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id])
  product        Product         @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  variant        ProductVariant? @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])
  saleAllocations SaleLineStockAllocation[]

  @@unique([businessUnitId, id])
  @@index([businessUnitId, locationId, productId, variantId, stockKind])
}

model Sale {
  id              String        @id @default(uuid()) @db.Uuid
  businessUnitId  String        @db.Uuid
  stockMovementId String        @db.Uuid
  invoiceNumber   String
  taxMode         SaleTaxMode
  customerName    String?
  customerPhone   String?
  subtotal        Decimal       @db.Decimal(14, 2)
  taxAmount       Decimal       @db.Decimal(14, 2)
  total           Decimal       @db.Decimal(14, 2)
  costOfGoods     Decimal       @db.Decimal(14, 2)
  createdBy       String
  createdAt       DateTime      @default(now())
  customerId      String?       @db.Uuid
  payments        Payment[]
  customer        Customer?     @relation(fields: [businessUnitId, customerId], references: [businessUnitId, id])
  businessUnit    BusinessUnit  @relation(fields: [businessUnitId], references: [id])
  stockMovement   StockMovement @relation(fields: [businessUnitId, stockMovementId], references: [businessUnitId, id])
  creator         User          @relation("SaleCreator", fields: [createdBy], references: [id])
  lines           SaleLine[]
  returns         SaleReturn[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, invoiceNumber])
  @@unique([businessUnitId, stockMovementId])
  @@index([businessUnitId, customerId])
  @@index([businessUnitId, createdAt])
  @@index([businessUnitId, customerName])
}

model SaleLine {
  id                String           @id @default(uuid()) @db.Uuid
  businessUnitId    String           @db.Uuid
  saleId            String           @db.Uuid
  productId         String           @db.Uuid
  variantId         String?          @db.Uuid
  productName       String
  sku               String
  baseUnit          MeasurementUnit
  productType       ProductType        @default(STANDARD)
  variantCode       String?
  variantAttributes Json?
  quantity          Decimal          @db.Decimal(18, 4)
  unitPrice         Decimal          @db.Decimal(14, 2)
  gstPercentage     Decimal          @db.Decimal(5, 2)
  lineSubtotal      Decimal          @db.Decimal(14, 2)
  lineTax           Decimal          @db.Decimal(14, 2)
  lineTotal         Decimal          @db.Decimal(14, 2)
  unitCost          Decimal          @db.Decimal(14, 4)
  lineCost          Decimal          @db.Decimal(14, 2)
  lineNumber        Int              @default(0)
  product           Product          @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  sale              Sale             @relation(fields: [businessUnitId, saleId], references: [businessUnitId, id])
  variant           ProductVariant?  @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])
  returns           SaleReturnLine[]
  stockAllocations  SaleLineStockAllocation[]

  @@unique([businessUnitId, saleId, lineNumber])
  @@unique([businessUnitId, saleId, id])
  @@index([businessUnitId, saleId])
  @@index([businessUnitId, productId])
}

model SaleLineStockAllocation {
  id                String           @id @default(uuid()) @db.Uuid
  businessUnitId    String           @db.Uuid
  saleLineId        String           @db.Uuid
  sourceType        StockKind
  stockBalanceId    String?          @db.Uuid
  remnantId         String?          @db.Uuid
  quantity          Decimal          @db.Decimal(18, 4)
  unit              MeasurementUnit
  conversionFactor  Decimal          @db.Decimal(18, 8)
  baseQuantity      Decimal          @db.Decimal(18, 4)
  unitCost          Decimal          @db.Decimal(14, 4)
  lineCost          Decimal          @db.Decimal(14, 2)
  createdAt         DateTime         @default(now())
  businessUnit      BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  saleLine          SaleLine         @relation(fields: [businessUnitId, saleLineId], references: [businessUnitId, id])
  stockBalance      StockBalance?    @relation(fields: [businessUnitId, stockBalanceId], references: [businessUnitId, id], onDelete: Restrict)
  remnant           MaterialRemnant? @relation(fields: [businessUnitId, remnantId], references: [businessUnitId, id], onDelete: Restrict)

  @@unique([businessUnitId, id])
  @@index([businessUnitId, saleLineId])
  @@index([businessUnitId, stockBalanceId])
  @@index([businessUnitId, sourceType, remnantId])
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  businessUnitId String              @db.Uuid
  supplierId     String              @db.Uuid
  orderNumber    String
  idempotencyKey String?
  status         PurchaseStatus      @default(ORDERED)
  taxMode        PurchaseTaxMode
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  notes          String?
  subtotal       Decimal             @db.Decimal(14, 2)
  taxAmount      Decimal             @db.Decimal(14, 2)
  total          Decimal             @db.Decimal(14, 2)
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  businessUnit   BusinessUnit        @relation(fields: [businessUnitId], references: [id])
  supplier       Supplier            @relation(fields: [businessUnitId, supplierId], references: [businessUnitId, id])
  creator        User                @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])
  lines          PurchaseOrderLine[]
  receipts       PurchaseReceipt[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, orderNumber])
  @@unique([businessUnitId, idempotencyKey])
  @@index([businessUnitId, status, orderDate])
  @@index([businessUnitId, supplierId, orderDate])
}

model PurchaseOrderLine {
  id                       String                @id @default(uuid()) @db.Uuid
  businessUnitId           String                @db.Uuid
  purchaseOrderId          String                @db.Uuid
  lineNumber               Int
  productId                String                @db.Uuid
  variantId                String?               @db.Uuid
  productName              String
  sku                      String
  baseUnit                 MeasurementUnit
  variantCode              String?
  variantAttributes        Json?
  quantity                 Decimal               @db.Decimal(18, 8)
  receivedQuantity         Decimal               @default(0) @db.Decimal(18, 8)
  unitCost                 Decimal               @db.Decimal(14, 4)
  gstPercentage            Decimal               @db.Decimal(5, 2)
  lineSubtotal             Decimal               @db.Decimal(14, 2)
  lineTax                  Decimal               @db.Decimal(14, 2)
  lineTotal                Decimal               @db.Decimal(14, 2)
  conversionFactor         Decimal               @db.Decimal(18, 8)
  conversionPrecision      Int
  purchaseQuantity         Decimal               @db.Decimal(18, 4)
  purchaseUnit             MeasurementUnit
  purchaseUnitCost         Decimal               @db.Decimal(14, 4)
  receivedPurchaseQuantity Decimal               @default(0) @db.Decimal(18, 4)
  roundingMode             RoundingMode
  product                  Product               @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  purchaseOrder            PurchaseOrder         @relation(fields: [businessUnitId, purchaseOrderId], references: [businessUnitId, id])
  variant                  ProductVariant?       @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])
  receiptLines             PurchaseReceiptLine[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, purchaseOrderId, lineNumber])
  @@index([businessUnitId, productId])
}

model PurchaseReceipt {
  id                    String                @id @default(uuid()) @db.Uuid
  businessUnitId        String                @db.Uuid
  stockMovementId       String                @db.Uuid
  purchaseOrderId       String                @db.Uuid
  supplierId            String                @db.Uuid
  locationId            String                @db.Uuid
  supplierInvoiceNumber String
  supplierInvoiceDate   DateTime?
  taxMode               PurchaseTaxMode
  subtotal              Decimal               @db.Decimal(14, 2)
  taxAmount             Decimal               @db.Decimal(14, 2)
  total                 Decimal               @db.Decimal(14, 2)
  receivedBy            String
  createdAt             DateTime              @default(now())
  payments              Payment[]
  businessUnit          BusinessUnit          @relation(fields: [businessUnitId], references: [id])
  location              StockLocation         @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id])
  purchaseOrder         PurchaseOrder         @relation(fields: [businessUnitId, purchaseOrderId], references: [businessUnitId, id])
  stockMovement         StockMovement         @relation(fields: [businessUnitId, stockMovementId], references: [businessUnitId, id])
  supplier              Supplier              @relation(fields: [businessUnitId, supplierId], references: [businessUnitId, id])
  receiver              User                  @relation("PurchaseReceiptCreator", fields: [receivedBy], references: [id])
  lines                 PurchaseReceiptLine[]
  returns               PurchaseReturn[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, stockMovementId])
  @@unique([businessUnitId, supplierId, supplierInvoiceNumber])
  @@index([businessUnitId, createdAt])
  @@index([businessUnitId, purchaseOrderId])
}

model PurchaseReceiptLine {
  id                  String               @id @default(uuid()) @db.Uuid
  businessUnitId      String               @db.Uuid
  purchaseReceiptId   String               @db.Uuid
  purchaseOrderLineId String               @db.Uuid
  lineNumber          Int
  productId           String               @db.Uuid
  variantId           String?              @db.Uuid
  productName         String
  sku                 String
  baseUnit            MeasurementUnit
  variantCode         String?
  variantAttributes   Json?
  quantity            Decimal              @db.Decimal(18, 8)
  unitCost            Decimal              @db.Decimal(14, 4)
  gstPercentage       Decimal              @db.Decimal(5, 2)
  lineSubtotal        Decimal              @db.Decimal(14, 2)
  lineTax             Decimal              @db.Decimal(14, 2)
  lineTotal           Decimal              @db.Decimal(14, 2)
  conversionFactor    Decimal              @db.Decimal(18, 8)
  conversionPrecision Int
  purchaseQuantity    Decimal              @db.Decimal(18, 4)
  purchaseUnit        MeasurementUnit
  purchaseUnitCost    Decimal              @db.Decimal(14, 4)
  roundingMode        RoundingMode
  product             Product              @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  purchaseOrderLine   PurchaseOrderLine    @relation(fields: [businessUnitId, purchaseOrderLineId], references: [businessUnitId, id])
  receipt             PurchaseReceipt      @relation(fields: [businessUnitId, purchaseReceiptId], references: [businessUnitId, id])
  variant             ProductVariant?      @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])
  returns             PurchaseReturnLine[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, purchaseReceiptId, lineNumber])
  @@unique([businessUnitId, purchaseReceiptId, id])
  @@index([businessUnitId, purchaseOrderLineId])
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  businessUnitId    String           @db.Uuid
  saleId            String?          @db.Uuid
  purchaseReceiptId String?          @db.Uuid
  idempotencyKey    String
  amount            Decimal          @db.Decimal(14, 2)
  method            PaymentMethod
  reference         String?
  notes             String?
  paidAt            DateTime         @default(now())
  recordedBy        String
  createdAt         DateTime         @default(now())
  reversedAt        DateTime?
  reversedBy        String?
  reversalReason    String?
  businessUnit      BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  purchaseReceipt   PurchaseReceipt? @relation(fields: [businessUnitId, purchaseReceiptId], references: [businessUnitId, id])
  sale              Sale?            @relation(fields: [businessUnitId, saleId], references: [businessUnitId, id])
  recorder          User             @relation("PaymentRecorder", fields: [recordedBy], references: [id])
  reverser          User?            @relation("PaymentReverser", fields: [reversedBy], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, idempotencyKey])
  @@index([businessUnitId, saleId, paidAt])
  @@index([businessUnitId, purchaseReceiptId, paidAt])
}

model SaleReturn {
  id                     String           @id @default(uuid()) @db.Uuid
  businessUnitId         String           @db.Uuid
  saleId                 String           @db.Uuid
  stockMovementId        String           @db.Uuid
  locationId             String           @db.Uuid
  creditNoteNumber       String
  idempotencyKey         String
  reason                 String
  subtotal               Decimal          @db.Decimal(14, 2)
  taxAmount              Decimal          @db.Decimal(14, 2)
  total                  Decimal          @db.Decimal(14, 2)
  createdBy              String
  createdAt              DateTime         @default(now())
  reversalMovementId     String?          @db.Uuid
  reversalIdempotencyKey String?
  reversedBy             String?
  reversedAt             DateTime?
  reversalReason         String?
  businessUnit           BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  location               StockLocation    @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id])
  reversalMovement       StockMovement?   @relation("SaleReturnReversalMovement", fields: [businessUnitId, reversalMovementId], references: [businessUnitId, id])
  sale                   Sale             @relation(fields: [businessUnitId, saleId], references: [businessUnitId, id])
  stockMovement          StockMovement    @relation(fields: [businessUnitId, stockMovementId], references: [businessUnitId, id])
  creator                User             @relation("SaleReturnCreator", fields: [createdBy], references: [id])
  reverser               User?            @relation("SaleReturnReverser", fields: [reversedBy], references: [id], onDelete: Restrict)
  lines                  SaleReturnLine[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, id, saleId])
  @@unique([businessUnitId, stockMovementId])
  @@unique([businessUnitId, reversalMovementId])
  @@unique([businessUnitId, reversalIdempotencyKey])
  @@unique([businessUnitId, creditNoteNumber])
  @@unique([businessUnitId, idempotencyKey])
  @@index([businessUnitId, saleId, createdAt])
}

model SaleReturnLine {
  id                String                @id @default(uuid()) @db.Uuid
  businessUnitId    String                @db.Uuid
  saleReturnId      String                @db.Uuid
  saleId            String                @db.Uuid
  saleLineId        String                @db.Uuid
  lineNumber        Int
  productId         String                @db.Uuid
  variantId         String?               @db.Uuid
  productName       String
  sku               String
  baseUnit          MeasurementUnit
  variantCode       String?
  variantAttributes Json?
  quantity          Decimal               @db.Decimal(18, 4)
  disposition       SaleReturnDisposition
  unitPrice         Decimal               @db.Decimal(14, 2)
  gstPercentage     Decimal               @db.Decimal(5, 2)
  lineSubtotal      Decimal               @db.Decimal(14, 2)
  lineTax           Decimal               @db.Decimal(14, 2)
  lineTotal         Decimal               @db.Decimal(14, 2)
  unitCost          Decimal               @db.Decimal(14, 4)
  lineCost          Decimal               @db.Decimal(14, 2)
  product           Product               @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  saleLine          SaleLine              @relation(fields: [businessUnitId, saleId, saleLineId], references: [businessUnitId, saleId, id])
  saleReturn        SaleReturn            @relation(fields: [businessUnitId, saleReturnId, saleId], references: [businessUnitId, id, saleId])
  variant           ProductVariant?       @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])

  @@unique([businessUnitId, saleReturnId, lineNumber])
  @@index([businessUnitId, saleLineId])
}

model PurchaseReturn {
  id                     String               @id @default(uuid()) @db.Uuid
  businessUnitId         String               @db.Uuid
  purchaseReceiptId      String               @db.Uuid
  stockMovementId        String               @db.Uuid
  locationId             String               @db.Uuid
  debitNoteNumber        String
  idempotencyKey         String
  reason                 String
  subtotal               Decimal              @db.Decimal(14, 2)
  taxAmount              Decimal              @db.Decimal(14, 2)
  total                  Decimal              @db.Decimal(14, 2)
  createdBy              String
  createdAt              DateTime             @default(now())
  reversalMovementId     String?              @db.Uuid
  reversalIdempotencyKey String?
  reversedBy             String?
  reversedAt             DateTime?
  reversalReason         String?
  businessUnit           BusinessUnit         @relation(fields: [businessUnitId], references: [id])
  location               StockLocation        @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id])
  purchaseReceipt        PurchaseReceipt      @relation(fields: [businessUnitId, purchaseReceiptId], references: [businessUnitId, id])
  reversalMovement       StockMovement?       @relation("PurchaseReturnReversalMovement", fields: [businessUnitId, reversalMovementId], references: [businessUnitId, id])
  stockMovement          StockMovement        @relation(fields: [businessUnitId, stockMovementId], references: [businessUnitId, id])
  creator                User                 @relation("PurchaseReturnCreator", fields: [createdBy], references: [id])
  reverser               User?                @relation("PurchaseReturnReverser", fields: [reversedBy], references: [id], onDelete: Restrict)
  lines                  PurchaseReturnLine[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, id, purchaseReceiptId])
  @@unique([businessUnitId, stockMovementId])
  @@unique([businessUnitId, reversalMovementId])
  @@unique([businessUnitId, reversalIdempotencyKey])
  @@unique([businessUnitId, debitNoteNumber])
  @@unique([businessUnitId, idempotencyKey])
  @@index([businessUnitId, purchaseReceiptId, createdAt])
}

model PurchaseReturnLine {
  id                  String              @id @default(uuid()) @db.Uuid
  businessUnitId      String              @db.Uuid
  purchaseReturnId    String              @db.Uuid
  purchaseReceiptId   String              @db.Uuid
  receiptLineId       String              @db.Uuid
  lineNumber          Int
  productId           String              @db.Uuid
  variantId           String?             @db.Uuid
  productName         String
  sku                 String
  baseUnit            MeasurementUnit
  variantCode         String?
  variantAttributes   Json?
  purchaseQuantity    Decimal             @db.Decimal(18, 4)
  purchaseUnit        MeasurementUnit
  conversionFactor    Decimal             @db.Decimal(18, 8)
  conversionPrecision Int
  roundingMode        RoundingMode
  quantity            Decimal             @db.Decimal(18, 8)
  unitCost            Decimal             @db.Decimal(14, 4)
  purchaseUnitCost    Decimal             @db.Decimal(14, 4)
  stockUnitCost       Decimal             @db.Decimal(14, 4)
  gstPercentage       Decimal             @db.Decimal(5, 2)
  lineSubtotal        Decimal             @db.Decimal(14, 2)
  lineTax             Decimal             @db.Decimal(14, 2)
  lineTotal           Decimal             @db.Decimal(14, 2)
  product             Product             @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  receiptLine         PurchaseReceiptLine @relation(fields: [businessUnitId, purchaseReceiptId, receiptLineId], references: [businessUnitId, purchaseReceiptId, id])
  purchaseReturn      PurchaseReturn      @relation(fields: [businessUnitId, purchaseReturnId, purchaseReceiptId], references: [businessUnitId, id, purchaseReceiptId])
  variant             ProductVariant?     @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])

  @@unique([businessUnitId, purchaseReturnId, lineNumber])
  @@index([businessUnitId, receiptLineId])
}

model MaterialProcessing {
  id              String             @id @default(uuid()) @db.Uuid
  movementId      String             @unique @db.Uuid
  productId       String             @db.Uuid
  variantId       String?            @db.Uuid
  sourceRemnantId String?            @unique @db.Uuid
  type            MaterialProcessingType
  inputLength     Decimal?           @db.Decimal(12, 4)
  inputWidth      Decimal?           @db.Decimal(12, 4)
  inputQuantity   Decimal             @default(0) @db.Decimal(14, 4)
  inputUnit       MeasurementUnit?
  consumedQuantity Decimal            @default(0) @db.Decimal(14, 4)
  outputUnit      MeasurementUnit?
  wastedQuantity  Decimal             @default(0) @db.Decimal(14, 4)
  soldArea        Decimal            @default(0) @db.Decimal(14, 4)
  wastedArea      Decimal            @default(0) @db.Decimal(14, 4)
  createdAt       DateTime           @default(now())
  businessUnitId  String             @db.Uuid
  businessUnit    BusinessUnit       @relation(fields: [businessUnitId], references: [id])
  movement        StockMovement      @relation(fields: [businessUnitId, movementId], references: [businessUnitId, id])
  product         Product            @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  sourceRemnant   MaterialRemnant?           @relation("RemnantSource", fields: [businessUnitId, sourceRemnantId], references: [businessUnitId, id])
  variant         ProductVariant?    @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])
  outputRemnants  MaterialRemnant[]          @relation("RemnantOutput")
  remnantHistory  MaterialRemnantMovement[]

  @@unique([businessUnitId, id])
  @@unique([businessUnitId, movementId])
  @@unique([businessUnitId, sourceRemnantId])
  @@index([businessUnitId, productId, createdAt])
  @@map("PanelOperation")
}

model MaterialRemnant {
  id                String            @id @default(uuid()) @db.Uuid
  code              String
  productId         String            @db.Uuid
  variantId         String?           @db.Uuid
  locationId        String            @db.Uuid
  sourceOperationId String?           @db.Uuid
  length            Decimal?          @db.Decimal(12, 4)
  width             Decimal?          @db.Decimal(12, 4)
  area              Decimal?          @db.Decimal(14, 4)
  quantity          Decimal           @default(0) @db.Decimal(14, 4)
  unit              MeasurementUnit?
  unitCost          Decimal           @default(0) @db.Decimal(14, 4)
  status            MaterialRemnantStatus     @default(AVAILABLE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  businessUnitId    String            @db.Uuid
  usedAsSource      MaterialProcessing?   @relation("RemnantSource")
  businessUnit      BusinessUnit      @relation(fields: [businessUnitId], references: [id])
  location          StockLocation     @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id])
  product           Product           @relation(fields: [businessUnitId, productId], references: [businessUnitId, id])
  sourceOperation   MaterialProcessing?   @relation("RemnantOutput", fields: [businessUnitId, sourceOperationId], references: [businessUnitId, id])
  variant           ProductVariant?   @relation(fields: [businessUnitId, variantId], references: [businessUnitId, id])
  movements         MaterialRemnantMovement[]
  saleAllocations   SaleLineStockAllocation[]

  @@unique([businessUnitId, code])
  @@unique([businessUnitId, id])
  @@index([businessUnitId, productId, variantId, status])
  @@index([businessUnitId, locationId, status])
  @@map("Remnant")
}

model MaterialRemnantMovement {
  id             String              @id @default(uuid()) @db.Uuid
  remnantId      String              @db.Uuid
  operationId    String?             @db.Uuid
  locationId     String              @db.Uuid
  actorId        String
  type           MaterialRemnantMovementType
  quantityDelta  Decimal             @db.Decimal(14, 4)
  reason         String?
  createdAt      DateTime            @default(now())
  businessUnitId String              @db.Uuid
  actor          User                @relation(fields: [actorId], references: [id])
  businessUnit   BusinessUnit        @relation(fields: [businessUnitId], references: [id])
  location       StockLocation       @relation(fields: [businessUnitId, locationId], references: [businessUnitId, id])
  operation      MaterialProcessing?     @relation(fields: [businessUnitId, operationId], references: [businessUnitId, id])
  materialRemnant        MaterialRemnant             @relation(fields: [businessUnitId, remnantId], references: [businessUnitId, id])

  @@index([businessUnitId, remnantId, createdAt])
  @@map("RemnantMovement")
}

model LowStockNotification {
  id             String       @id @default(cuid())
  userId         String
  businessUnitId String       @db.Uuid
  productId      String       @db.Uuid
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [businessUnitId, productId], references: [businessUnitId, id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessUnitId, productId])
  @@index([userId, businessUnitId, isRead])
}

enum BarcodeType {
  INTERNAL
  MANUFACTURER
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum LegacyBusinessUnit {
  KB_INTERIORS
  KB_ELECTRICALS
  KB_FURNITURE
  KB_KITCHEN_BATH
  KB_TOOLS
  KB_TECH
}

enum RoleScope {
  GROUP
  BUSINESS_UNIT
}

enum MeasurementUnit {
  PCS
  SQFT
  BOX
  RFT
  ROLL
  METER
  KG
  LITRE
  BUNDLE
  SET
}

enum ProductType {
  STANDARD
  MATERIAL @map("PANEL")
}

enum RoundingMode {
  HALF_UP
  HALF_EVEN
  DOWN
  UP
}

enum StockMovementType {
  OPENING
  PURCHASE_IN
  INWARD
  OUTWARD
  ADJUSTMENT
  TRANSFER
  MATERIAL_PROCESSING @map("PANEL_OPERATION")
  SALE
  PURCHASE_RETURN
  PURCHASE_RETURN_REVERSAL
  SALE_RETURN
  SALE_RETURN_REVERSAL
}

enum SaleTaxMode {
  GST
  NON_GST
}

enum PurchaseTaxMode {
  GST
  NON_GST
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum SaleReturnDisposition {
  RESTOCK
  DAMAGED
}

enum PurchaseStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
}

enum StockKind {
  STANDARD
  REMNANT
}

enum MaterialProcessingType {
  CUT
  REMNANT_SALE
  WASTAGE
  ADJUSTMENT
  @@map("PanelOperationType")
}

enum MaterialRemnantStatus {
  AVAILABLE
  SOLD
  CONSUMED
  WASTED
  ADJUSTED
  @@map("RemnantStatus")
}

enum MaterialRemnantMovementType {
  CREATED
  SOLD
  CONSUMED
  WASTED
  ADJUSTED
  TRANSFERRED
  @@map("RemnantMovementType")
}
