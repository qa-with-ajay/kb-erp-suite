POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="kb_erp"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://kb_user:replace-with-a-strong-password@localhost:5433/kb_erp?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
