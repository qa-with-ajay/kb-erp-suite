# Keep these PostgreSQL values aligned with DATABASE_URL.
POSTGRES_USER="kb_user"
POSTGRES_PASSWORD="replace-with-a-strong-password"

POSTGRES_DB="kb_erp_accounting_dev"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://kb_user:replace-with-a-strong-password@localhost:5433/kb_erp_accounting_dev?schema=public"

AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Password reset email delivery (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-character-google-app-password"
EMAIL_FROM="KB-ERP <your-email@gmail.com>"
